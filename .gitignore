.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.profile
.pytest_cache/
.hypothesis/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Sphinx documentation
doc/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to share your .python-version.
#   For an app, this can be annoying.
#.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in git.
#   However, in case of collaboration, if used with a virtualenv, it may be better to ignore.
#   Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock can be ignored or committed.
#   poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock can be ignored or committed.
#   pdm.lock

# PEP 582; project local packages directory (used by pdm)
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

